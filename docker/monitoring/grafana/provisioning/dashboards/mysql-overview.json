   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "panels": []
  },
  {
   "id": 9,
   "title": "连接数",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_threads_connected{instance=~\"$instance\"}",
     "legendFormat": "已连接",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_threads_running{instance=~\"$instance\"}",
     "legendFormat": "运行中",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_variables_max_connections{instance=~\"$instance\"}",
     "legendFormat": "上限 max_connections",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "title": "连接建立与失败",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "握手失败持续增长通常意味着密码错误、网络问题或连接数已满",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_connections{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "新建连接/秒",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_aborted_connects{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "握手失败/秒",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_aborted_clients{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "客户端异常断开/秒",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_connection_errors_total{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "连接错误/秒 {{error}}",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "吞吐与慢查询",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "panels": []
  },
  {
   "id": 12,
   "title": "QPS / TPS",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 18
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_questions{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "QPS",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_commands_total{command=\"commit\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "提交/秒",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_commands_total{command=\"rollback\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "回滚/秒",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
