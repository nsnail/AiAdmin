   "title": "缓冲池页面",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "state=data 为已用的数据页，free 为空闲页，misc 为其他；空闲页接近 0 说明缓冲池已用满",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 36
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_buffer_pool_pages{instance=~\"$instance\"}",
     "legendFormat": "{{state}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_buffer_pool_dirty_pages{instance=~\"$instance\"}",
     "legendFormat": "脏页",
