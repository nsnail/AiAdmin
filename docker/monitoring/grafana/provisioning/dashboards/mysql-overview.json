  {
   "id": 16,
   "title": "行锁等待",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "持续大于 0 说明有事务在互相等锁，这类问题正是之前连接池耗尽的原因之一",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 28
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_innodb_row_lock_current_waits{instance=~\"$instance\"}",
     "legendFormat": "当前等待行锁的事务",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_innodb_row_lock_waits{instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "行锁等待/秒",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 17,
   "title": "行锁等待耗时",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 28
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(mysql_global_status_innodb_row_lock_time{instance=~\"$instance\"}[$__rate_interval])",
