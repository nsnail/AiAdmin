    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "title": "各类语句每秒数",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (command) (rate(mysql_global_status_commands_total{command=~\"select|insert|update|delete|replace\",instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "{{command}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
