    "h": 4,
    "w": 4,
    "x": 16,
    "y": 2
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "mysql_global_status_threads_running{instance=~\"$instance\"}",
     "legendFormat": "",
