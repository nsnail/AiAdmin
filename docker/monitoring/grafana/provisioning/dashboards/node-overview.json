   }
  },
  {
   "id": 10,
   "title": "CPU 时间分布",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "iowait 偏高说明在等磁盘，steal 偏高说明云主机被宿主机抢占，system 偏高多为网络或系统调用开销",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "avg by (mode, instance, role) (rate(node_cpu_seconds_total{job=\"node\",instance=~\"$instance\",mode!=\"idle\"}[$__rate_interval])) * 100",
     "legendFormat": "{{role}} {{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
