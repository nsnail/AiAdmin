    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "title": "内存构成",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "已用 = 总量 - 可用；缓存可被内核回收，已包含在可用里",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "node_memory_MemTotal_bytes{job=\"node\",instance=~\"$instance\"} - node_memory_MemAvailable_bytes{job=\"node\",instance=~\"$instance\"}",
     "legendFormat": "{{role}} 已用",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "node_memory_Cached_bytes{job=\"node\",instance=~\"$instance\"} + node_memory_Buffers_bytes{job=\"node\",instance=~\"$instance\"}",
     "legendFormat": "{{role}} 缓存",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "node_memory_MemAvailable_bytes{job=\"node\",instance=~\"$instance\"}",
     "legendFormat": "{{role}} 可用",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 15,
   "title": "Swap 使用与换页",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "换入换出持续不为 0 说明物理内存不足，性能会明显下降",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "node_memory_SwapTotal_bytes{job=\"node\",instance=~\"$instance\"} - node_memory_SwapFree_bytes{job=\"node\",instance=~\"$instance\"}",
     "legendFormat": "{{role}} Swap 已用",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(node_vmstat_pswpin{job=\"node\",instance=~\"$instance\"}[$__rate_interval]) * 4096",
     "legendFormat": "{{role}} 换入/秒",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rate(node_vmstat_pswpout{job=\"node\",instance=~\"$instance\"}[$__rate_interval]) * 4096",
     "legendFormat": "{{role}} 换出/秒",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
