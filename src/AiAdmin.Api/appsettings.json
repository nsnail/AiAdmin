{
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=aiadmin.db",
    "SqlServer": "Server=localhost;Database=AiAdmin;Trusted_Connection=True;TrustServerCertificate=True",
    "PostgreSQL": "Host=localhost;Port=5432;Database=aiadmin;Username=postgres;Password=postgres",
    "MySQL": "Server=localhost;Port=3306;Database=aiadmin;User=root;Password=your-password",
    "Redis": "localhost:6379"
  },
  "Snowflake": {
