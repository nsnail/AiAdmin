    "ExpiresMinutes": 120
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": ""
  },
  "Cors": {
    "Origins": [
      "http://localhost:3006"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
